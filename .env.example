# DBS Tool — Environment Variables
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://user:pass@host:5432/nextstep
NEXTSTEP_INTERNAL_TOKEN=change-this-to-a-strong-secret
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL_FAST=gemini-2.0-flash-001
GEMINI_MODEL_STRONG=gemini-2.5-pro

MAX_CONCURRENT_TASKS=1
WORKER_POLL_INTERVAL=2
TASK_TIMEOUT_SECONDS=600
MAX_TASK_RETRIES=1
ZIP_ON_COMPLETE=true
BACKEND_VALIDATE_URL=https://nextstep-backend-e75l.onrender.com/api/validate-session
APP_DASHBOARD_URL=https://nextstep-backend-e75l.onrender.com/dashboard
APP_LOGIN_URL=https://nextstep-backend-e75l.onrender.com/login